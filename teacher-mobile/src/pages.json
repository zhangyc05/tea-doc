{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/activity/index",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/todo/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/todo/all/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/todo/dynamics/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/todo/certificate-detail/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/todo/certificate-edit/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/todo/certificate-submit/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/archive/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationStyle": "custom"
      }
    }
  ],
  "globalStyle": {
    "navigationStyle": "custom",
    "backgroundColor": "#F7FAFF",
    "backgroundTextStyle": "dark",
    "navigationBarTextStyle": "black"
  }
}
